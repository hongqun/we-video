DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
APP_PASSWORD=
SESSION_SECRET=
# 默认内容上下文。账号目录为 data/local/content/<accountId>/，专题目录为其下的 series/<seriesId>/。
# 填入你自己的账号与专题 ID。
TALK_VIDEO_ACCOUNT=
TALK_VIDEO_SERIES=
# 留空时分别使用仓库内 content/ 和 pipeline.config.json；相对路径均以仓库根目录解析。
TALK_VIDEO_PROFILES_DIR=
TALK_VIDEO_PIPELINE_CONFIG=
# 数据目录留空时使用仓库根目录；生产环境通常设置为 /opt/talk-video/data。
TALK_VIDEO_DATA_DIR=
# 专题提示词目录的部署级覆盖。留空时使用 series.json 中的 promptDirectory。
TALK_VIDEO_PROMPT_DIR=

# 生成与语音的可选部署覆盖；留空时使用 pipeline.config.json 的结构化配置。
TALK_VIDEO_TEXT_MODELS=
TALK_VIDEO_DEFAULT_TEXT_MODEL=
TALK_VIDEO_DEEPSEEK_BASE_URL=
# 可选的本地部署覆盖。Workspace ID 是项目标识，不是密钥；公开示例留空。
TALK_VIDEO_BAILIAN_WORKSPACE_ID=
TALK_VIDEO_BAILIAN_API_URL=
TALK_VIDEO_TTS_MODEL=
TALK_VIDEO_DEFAULT_VOICE=
TALK_VIDEO_TTS_SAMPLE_RATE=
TALK_VIDEO_TTS_VOLUME=
TALK_VIDEO_TTS_RATE=
TALK_VIDEO_TTS_PITCH=
TALK_VIDEO_TTS_INSTRUCTION=
TALK_VIDEO_TTS_SEED=
TALK_VIDEO_TTS_ENABLE_AIGC_TAG=

# 账号/专题公开品牌信息的可选部署覆盖；留空时使用 account.json 与 series.json。
TALK_VIDEO_BRAND_TITLE=
TALK_VIDEO_BRAND_SUBTITLE=
TALK_VIDEO_DISPLAY_LABEL=
TALK_VIDEO_SERIES_TITLE=
TALK_VIDEO_SERIES_DESCRIPTION=
TALK_VIDEO_WORKSPACE_NAME=
TALK_VIDEO_WORKSPACE_TITLE=
TALK_VIDEO_WORKSPACE_DESCRIPTION=
TALK_VIDEO_DOWNLOAD_PREFIX=
TALK_VIDEO_USER_AGENT_SUFFIX=
TALK_VIDEO_LOGO=
# 生产环境固定公网地址；本地开发可留空并回退到当前请求地址。
APP_PUBLIC_ORIGIN=
# 浏览器通过局域网 IP 访问开发服务时，填入对应主机名/IP（逗号分隔）。
NEXT_ALLOWED_DEV_ORIGINS=localhost,127.0.0.1
# SSH 隧道访问使用 HTTP，因此默认关闭；只有在 HTTPS 反向代理后才设为 true。
AUTH_COOKIE_SECURE=false
# 生成的音视频（.wav / output.mp4）保留天数；超过则按文件 mtime 自动清理。留空=15。
TALK_VIDEO_MEDIA_RETENTION_DAYS=
# 自动清理执行间隔（毫秒）；留空=21600000（6 小时）。服务启动时也会立即执行一次。
TALK_VIDEO_MEDIA_CLEANUP_INTERVAL_MS=
