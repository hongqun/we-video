{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "视觉资源的可选自动图表执行状态",
  "type": "object",
  "properties": {
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "idle",
            "running",
            "ready",
            "failed",
            "cancelled",
            "interrupted",
            "stale"
          ]
        },
        "requestId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "traceId": {
          "type": "string"
        }
      }
    }
  }
}
