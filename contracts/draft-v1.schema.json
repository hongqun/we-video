{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "draft-v1.schema.json",
  "title": "DraftV1",
  "type": "object",
  "required": ["schemaVersion", "title", "language", "narrationSegments"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "shortTitle": {"type": "string"},
    "summary": {"type": "string"},
    "targetDurationSeconds": {"type": "integer", "minimum": 1},
    "captionStyle": {"enum": ["narration", "clean", "impact"]},
    "language": {"type":"object","required":["sourceLanguage","outputLanguage"],"properties":{"sourceLanguage":{"enum":["zh","en","mixed"]},"outputLanguage":{"const":"zh-CN"}}},
    "narrationSegments": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","spokenText","pauseAfter"],"properties":{"id":{"type":"string"},"spokenText":{"type":"string","minLength":1},"pauseAfter":{"enum":["none","short","medium","long","auto"]},"keywords":{"type":"array","items":{"type":"string"}}}}},
    "visualsPlanned": {"type":"boolean"}
  }
}
