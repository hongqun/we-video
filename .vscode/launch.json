{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动 We-Video 工作台",
      "type": "node-terminal",
      "request": "launch",
      // 调试时使用 Webpack，避开 Turbopack 内部 HMR 源码映射的重复读取警告。
      "command": "npm run dev -- --webpack",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "启动 We-Video Remotion Studio",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run studio",
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "pattern": "http://localhost:(\\d+)",
        "uriFormat": "http://localhost:%s",
        "action": "openExternally"
      }
    }
  ]
}
