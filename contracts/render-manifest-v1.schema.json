{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render-manifest-v1.schema.json",
  "title": "RenderManifestV1",
  "type": "object",
  "required": ["schemaVersion", "jobId", "revision", "title", "video", "narration", "captions", "scenes", "brand"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "contentMode": {"const": "narration"},
    "jobId": {"type": "string"},
    "revision": {"type": "integer", "minimum": 1},
    "contentProfile": {"type":"object"},
    "title": {"type": "string", "minLength": 1},
    "visualStyle": {"enum": ["kinetic-lime", "layered-mint", "deep-signal"]},
    "shortTitle": {"type": "string"},
    "cover": {"type":"object","additionalProperties":false,"required":["title","subtitle","keywords","presenterPoseId"],"properties":{"title":{"type":"string","minLength":1,"maxLength":40},"subtitle":{"type":"string","maxLength":120},"keywords":{"type":"array","maxItems":8,"items":{"type":"string","minLength":1,"maxLength":24}},"presenterPoseId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{1,63}$"},"imagePath":{"type":"string","minLength":1},"imageWidth":{"type":"integer","minimum":1},"imageHeight":{"type":"integer","minimum":1}},"anyOf":[{"not":{"anyOf":[{"required":["imagePath"]},{"required":["imageWidth"]},{"required":["imageHeight"]}]}},{"required":["imagePath","imageWidth","imageHeight"]}]},
    "summary": {"type": "string"},
    "captionStyle": {"enum": ["narration", "clean", "impact"]},
    "video": {"type":"object","required":["width","height","fps","outroDurationMs"],"properties":{"width":{"const":1080},"height":{"const":1260},"fps":{"const":30},"outroDurationMs":{"const":3000}}},
    "narration": {"type":"object","required":["text","audioSrc","durationMs","model","voice"],"properties":{"text":{"type":"string"},"audioSrc":{"type":"string"},"spokenDurationMs":{"type":"integer"},"durationMs":{"type":"integer","minimum":1},"model":{"type":"string"},"voice":{"type":"string"}}},
    "captions": {"type":"array","items":{"type":"object"}},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id","segmentId","startMs","endMs","transition","spokenText","content","templateId","rollType","presenterMode","presenterPoseId","presenterPlacement"],
        "properties": {
          "id":{"type":"string"},"segmentId":{"type":"string"},"startMs":{"type":"integer","minimum":0},"endMs":{"type":"integer","minimum":1},
          "speechStartMs":{"type":"integer","minimum":0},"speechEndMs":{"type":"integer","minimum":1},"pauseAfterMs":{"type":"integer","minimum":0,"maximum":700},
          "transition":{"oneOf":[{"type":"object","additionalProperties":false,"required":["kind","durationMs"],"properties":{"kind":{"const":"none"},"durationMs":{"const":0}}},{"type":"object","additionalProperties":false,"required":["kind","durationMs"],"properties":{"kind":{"enum":["fade","slide-left","slide-up","zoom-in","wipe-right"]},"durationMs":{"type":"integer","minimum":240,"maximum":360}}}]},
          "spokenText":{"type":"string"},
          "content":{"type":"object","additionalProperties":false,"required":["title","subtitle","text","keywords"],"properties":{"title":{"type":"string","minLength":1},"subtitle":{"type":"string"},"text":{"type":"string"},"keywords":{"type":"array","items":{"type":"string"}},"emphasisBindings":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["text","cueText"],"properties":{"text":{"type":"string","minLength":1},"cueText":{"type":"string","minLength":1}}}}}},
          "templateId":{"type":"string","minLength":1},
          "templateData":{"type":"object"},
          "rollType":{"enum":["a-roll","b-roll"]},"presenterMode":{"enum":["hero","companion","hidden"]},"presenterPoseId":{"type":"string"},"presenterPlacement":{"enum":["hero","left-mid","right-mid","left-lower","right-lower"]},"presenterFraming":{"enum":["full","three-quarter","waist","bust"]}
        }
      }
    },
    "brand":{"type":"object"},
    "presenter":{"type":"object"},
    "media":{"type":"object"}
  }
}
